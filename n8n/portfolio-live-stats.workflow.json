    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collects the measurements from earlier nodes. Anything that failed or is\n// missing becomes null, which the website hides instead of showing a guess.\nconst sd = $getWorkflowStaticData('global');\nconst first = (name) => { try { return $(name).first().json; } catch (e) { return null; } };\n\nconst profile = first('GitHub profile');\nconst c30 = first('GitHub commits 30d');\nconst cAll = first('GitHub commits total');\nconst psi = first('PageSpeed mobile');\n\nconst total = (j) => (j && typeof j.total_count === 'number' ? j.total_count : null);\nconst score = (k) => {\n  const v = psi && psi.lighthouseResult && psi.lighthouseResult.categories && psi.lighthouseResult.categories[k];\n  return v && typeof v.score === 'number' ? Math.round(v.score * 100) : null;\n};\n\n// Executions: skip this workflow itself, manual test runs, and anything older than 30 days.\nconst all = $input.all().map((i) => i.json).filter((e) => e && e.id);\nconst cutoff = Date.now() - 30 * 24 * 60 * 60 * 1000;\nconst runs = all.filter(\n  (e) => String(e.workflowId) !== String($workflow.id) && e.mode !== 'manual' && Date.parse(e.startedAt) >= cutoff\n);\nconst apiWorked = all.length > 0;\n\nconst stats = {\n  updatedAt: new Date().toISOString(),\n  github: {\n    commits30d: total(c30),\n    commitsTotal: total(cAll),\n    publicRepos: profile && typeof profile.public_repos === 'number' ? profile.public_repos : null,\n  },\n  n8n: {\n    runs30d: apiWorked ? runs.length : null,\n    successRate: apiWorked && runs.length ? Math.round((runs.filter((e) => e.status === 'success').length / runs.length) * 100) : null,\n  },\n  lighthouse: {\n    url: psi && psi.lighthouseResult ? psi.lighthouseResult.finalUrl : null,\n    performance: score('performance'),\n    accessibility: score('accessibility'),\n    bestPractices: score('best-practices'),\n    seo: score('seo'),\n  },\n};\n\n// Only saved when the workflow is active (production runs), not on manual test runs.\nsd.stats = stats;\nreturn [{ json: stats }];\n"
      },
